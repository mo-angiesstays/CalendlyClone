# Copy this file to ".env" and fill in the three required values.

# 1) From Google Cloud Console -> APIs & Services -> Credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2) Pick any password. You'll use it to sign in to the admin area.
ADMIN_PASSWORD=

# 3) Where the app is reachable. Keep the default while running on your own computer.
#    When you deploy it online, change this to your real address, e.g. https://book.yourdomain.com
PUBLIC_URL=http://localhost:3000

# Optional
PORT=3000
# SESSION_SECRET=            (auto-generated and saved in data/ if left empty)
# DATA_DIR=./data            (where the app keeps its small database file)
