<%- include('partials/admin-top', { title: 'Overview' }) %>
<div class="page-head">
  <div>
    <h1>Good to see you<%= db.settings.hostName ? `, ${db.settings.hostName.split(' ')[0]}` : '' %>.</h1>
    <p>Everything here checks your Google Calendars live, so your availability is always current.</p>
  </div>
</div>

<% if (todo.connect || todo.name || todo.link) { %>
<div class="todo">
  <strong>Let's finish setting up</strong>
  <ol>
    <% if (todo.connect) { %><li><a href="/admin/calendars">Connect your Google account</a> and choose which calendars count as "busy".</li><% } %>
    <% if (todo.name) { %><li><a href="/admin/hours">Add your name and regular hours</a> so guests know who they're booking.</li><% } %>
    <% if (todo.link) { %><li><a href="/admin/links/new">Create your first booking link</a> and share it.</li><% } %>
  </ol>
</div>
<% } %>

<div class="stats">
  <div class="stat"><div class="num"><%= db.accounts.length %></div><div class="lbl">Google account<%= db.accounts.length === 1 ? '' : 's' %> connected</div></div>
  <div class="stat"><div class="num"><%= busyCalendars %></div><div class="lbl">calendar<%= busyCalendars === 1 ? '' : 's' %> checked for conflicts</div></div>
  <div class="stat"><div class="num"><%= db.links.filter(l => l.active).length %></div><div class="lbl">active booking link<%= db.links.filter(l => l.active).length === 1 ? '' : 's' %></div></div>
  <div class="stat"><div class="num"><%= db.bookings.filter(b => b.status === 'confirmed' && Date.parse(b.start) >= Date.now()).length %></div><div class="lbl">upcoming booking<%= db.bookings.filter(b => b.status === 'confirmed' && Date.parse(b.start) >= Date.now()).length === 1 ? '' : 's' %></div></div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Coming up</h2>
    <a class="btn ghost small" href="/admin/bookings">All bookings</a>
  </div>
  <% if (!upcoming.length) { %>
    <p class="muted">No upcoming bookings yet. Share a booking link and they'll appear here.</p>
  <% } else { %>
  <div class="list">
    <% upcoming.forEach(function (b) { %>
    <div class="list-item">
      <div class="grow">
        <div class="title"><%= b.name %> <span class="muted">· <%= b.linkName %></span></div>
        <div class="sub"><%= T.formatInstant(new Date(b.start), db.settings.timezone) %> – <%= T.formatTime(new Date(b.end), db.settings.timezone) %></div>
      </div>
      <% if (b.meetLink) { %><a class="btn secondary small" href="<%= b.meetLink %>" target="_blank" rel="noopener">Join Meet</a><% } %>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="card">
  <div class="card-head"><h2>Where bookings land</h2><a class="btn ghost small" href="/admin/calendars">Change</a></div>
  <% if (destination) { %>
    <p>New bookings are added to <strong><%= destination.calendar.name %></strong> <span class="muted">(<%= destination.account.email %>)</span>, and the guest receives a Google Calendar invitation automatically.</p>
  <% } else { %>
    <p class="muted">Connect a Google account first. Bookings will be written to its main calendar unless you pick another one.</p>
  <% } %>
</div>
<%- include('partials/admin-bottom') %>
