<%- include('head', { title }) %>
<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="/admin"><span class="leaf"></span><span><%= appName %></span></a>
    <nav class="nav">
      <a href="/admin" class="<%= path === '/' ? 'active' : '' %>"><svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Overview</a>
      <a href="/admin/calendars" class="<%= path.startsWith('/calendars') ? 'active' : '' %>"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>Calendars</a>
      <a href="/admin/hours" class="<%= path.startsWith('/hours') ? 'active' : '' %>"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Regular hours</a>
      <a href="/admin/links" class="<%= path.startsWith('/links') ? 'active' : '' %>"><svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg>Booking links</a>
      <a href="/admin/bookings" class="<%= path.startsWith('/bookings') ? 'active' : '' %>"><svg viewBox="0 0 24 24"><path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>Bookings</a>
    </nav>
    <div class="foot">
      <form method="post" action="/logout"><button class="btn ghost small" type="submit">Sign out</button></form>
    </div>
  </aside>
  <main class="main">
    <% if (ok) { %><div class="flash ok"><%= ok %></div><% } %>
    <% if (err) { %><div class="flash err"><%= err %></div><% } %>
